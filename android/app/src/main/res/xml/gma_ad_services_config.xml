<?xml version="1.0" encoding="utf-8"?>
<!--
  Unified AdServices config — Trivo Chat Elite
  Merges Google AdMob + Yandex Mobile Ads allow-lists so the Manifest Merger
  does not throw "Duplicate Property" errors. allowAllToAccess=true grants
  both networks access to the AdServices APIs introduced in Android 13/14/15.
-->
<ad-services-config>
    <topics allowAllToAccess="true" />
    <attribution allowAllToAccess="true" />
    <custom-audiences allowAllToAccess="true" />
    <protected-signals allowAllToAccess="true" />
    <ad-selection allowAllToAccess="true" />
</ad-services-config>
