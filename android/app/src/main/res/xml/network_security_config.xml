<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security — Trivo Chat Elite
  HTTPS-only by default. Cleartext is permitted ONLY on the loopback interface,
  which is where the Tor SOCKS proxy and the local onion listener live.
-->
<network-security-config>

    <!-- Default: HTTPS-only with HSTS for production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Loopback exception: the Tor daemon exposes its SOCKS5 port and the local
      onion service listener on 127.0.0.1. Those sockets are plain TCP by
      design (the transport itself is onion-encrypted), so cleartext must be
      permitted for localhost only — never for any public host.
      10.0.2.2 is the emulator's alias for the developer machine's loopback.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

</network-security-config>
